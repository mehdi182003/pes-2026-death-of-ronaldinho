# Build Rust
/target/

# Configuration locale du joueur (chemins vers ses copies des jeux)
/config.toml

# Cache d'extraction : normalement dans le dossier de cache de l'utilisateur,
# mais on bloque aussi toute copie locale par sécurité.
/cache/
/extracted/
/.chaos-fc-cache/

# ---------------------------------------------------------------------------
