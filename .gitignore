# La CI vérifie aussi que rien de tel n'est suivi par Git.
# ---------------------------------------------------------------------------
# RenderWare / GTA Vice City
*.img
*.dir
*.dff
*.txd
*.ifp
*.col
*.sfx
*.sdt
*.raw
*.adf
# PES 6
*.afs
*.bin
*.str
# Dumps et extractions bruts
*.dump

